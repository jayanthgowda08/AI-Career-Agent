# ================================
# AI Career Agent — Backend .env
# ================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to GitHub.

# --- Database ---
POSTGRES_USER=career_user
POSTGRES_PASSWORD=career_password
POSTGRES_DB=career_agent
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://career_user:career_password@localhost:5432/career_agent

# --- FastAPI / Security ---
SECRET_KEY=change-this-to-a-random-32-char-string-before-use
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Gemini AI ---
GEMINI_API_KEY=your-gemini-api-key-from-aistudio-google-com
GEMINI_MODEL=gemini-1.5-flash

# --- File Uploads ---
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=10

# --- App ---
ENVIRONMENT=development
LOG_LEVEL=INFO
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
